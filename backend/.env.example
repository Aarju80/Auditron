# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to .env and fill in values before running locally.
# None of these are required in the default local dev setup — the app will
# use the defaults shown below if the variable is not set.
# ---------------------------------------------------------------------------

# Port the Uvicorn server binds to (default: 8000)
PORT=8000

# Comma-separated list of allowed CORS origins.
# In production, replace * with the exact frontend origin(s).
# Example: https://page-pulse.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=*

# Hard timeout (seconds) for outbound HTTP fetches (default: 8)
TIMEOUT_SECONDS=8

# Maximum response body size in bytes (default: 5242880 = 5 MB)
MAX_BODY_BYTES=5242880
